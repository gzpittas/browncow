<% content_for :title, "Employees" %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
  <div>
    <p class="text-uppercase small fw-semibold text-primary mb-2">Setup</p>
    <h1 class="h2 fw-semibold mb-0">Employees</h1>
  </div>
  <% if @location %>
    <%= link_to "Add Employee", new_location_employee_path(@location), class: "btn btn-primary" %>
  <% end %>
</div>

<%= render "location_switcher" %>

<% if @location.blank? %>
  <div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-md-5">
      <h2 class="h4 fw-semibold mb-2">Add a location first</h2>
      <p class="text-secondary mb-4">Employees belong to a restaurant location.</p>
      <%= link_to "Add Location", new_location_path, class: "btn btn-primary" %>
    </div>
  </div>
<% elsif @employees.any? %>
  <% foh_positions = @sortable_positions.select { |position| position.section == "foh" } %>
  <% boh_positions = @sortable_positions.select { |position| position.section == "boh" } %>
  <div class="d-grid gap-4">
    <ul class="nav nav-tabs" id="employees-tabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button
          class="nav-link active"
          id="employees-list-tab"
          data-bs-toggle="tab"
          data-bs-target="#employees-list-panel"
          type="button"
          role="tab"
          aria-controls="employees-list-panel"
          aria-selected="true">
          Employees
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button
          class="nav-link"
          id="employees-rank-tab"
          data-bs-toggle="tab"
          data-bs-target="#employees-rank-panel"
          type="button"
          role="tab"
          aria-controls="employees-rank-panel"
          aria-selected="false">
          Rank by Position
        </button>
      </li>
    </ul>

    <div class="tab-content">
      <section
        class="tab-pane fade show active"
        id="employees-list-panel"
        role="tabpanel"
        aria-labelledby="employees-list-tab"
        tabindex="0">
        <div class="pt-4 d-grid gap-4">
          <ul class="nav nav-tabs mb-3" id="employees-list-subtabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button
                class="nav-link active"
                id="employees-list-foh-tab"
                data-bs-toggle="tab"
                data-bs-target="#employees-list-foh-panel"
                type="button"
                role="tab"
                aria-controls="employees-list-foh-panel"
                aria-selected="true">
                FOH
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button
                class="nav-link"
                id="employees-list-boh-tab"
                data-bs-toggle="tab"
                data-bs-target="#employees-list-boh-panel"
                type="button"
                role="tab"
                aria-controls="employees-list-boh-panel"
                aria-selected="false">
                BOH
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button
                class="nav-link"
                id="employees-list-all-tab"
                data-bs-toggle="tab"
                data-bs-target="#employees-list-all-panel"
                type="button"
                role="tab"
                aria-controls="employees-list-all-panel"
                aria-selected="false">
                All
              </button>
            </li>
          </ul>

          <div class="tab-content">
            <section
              class="tab-pane fade show active"
              id="employees-list-foh-panel"
              role="tabpanel"
              aria-labelledby="employees-list-foh-tab"
              tabindex="0">
              <%= render "employee_section", title: "FOH", employees: @employees_by_section["foh"], section_key: "foh" %>
            </section>

            <section
              class="tab-pane fade"
              id="employees-list-boh-panel"
              role="tabpanel"
              aria-labelledby="employees-list-boh-tab"
              tabindex="0">
              <%= render "employee_section", title: "BOH", employees: @employees_by_section["boh"], section_key: "boh" %>
            </section>

            <section
              class="tab-pane fade"
              id="employees-list-all-panel"
              role="tabpanel"
              aria-labelledby="employees-list-all-tab"
              tabindex="0">
              <div class="d-grid gap-4">
                <%= render "employee_section", title: "All Employees", employees: @employees, section_key: nil %>
                <% if @unassigned_employees.any? %>
                  <%= render "employee_section", title: "Unassigned", employees: @unassigned_employees, section_key: nil %>
                <% end %>
              </div>
            </section>
          </div>
        </div>
      </section>

      <section
        class="tab-pane fade"
        id="employees-rank-panel"
        role="tabpanel"
        aria-labelledby="employees-rank-tab"
        tabindex="0">
        <div class="card border-0 shadow-sm mt-4">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div>
              <h2 class="h5 fw-semibold mb-1">Rank By Position</h2>
              <p class="text-secondary mb-0">Drag employees within each position to control rank order for the combined schedule view.</p>
            </div>
            <span class="badge text-bg-light border"><%= pluralize(@sortable_positions.count, "position") %></span>
          </div>
          <div class="card-body p-4 d-grid gap-4">
            <ul class="nav nav-tabs mb-3" id="employees-rank-subtabs" role="tablist">
              <li class="nav-item" role="presentation">
                <button
                  class="nav-link active"
                  id="employees-rank-foh-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#employees-rank-foh-panel"
                  type="button"
                  role="tab"
                  aria-controls="employees-rank-foh-panel"
                  aria-selected="true">
                  FOH
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button
                  class="nav-link"
                  id="employees-rank-boh-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#employees-rank-boh-panel"
                  type="button"
                  role="tab"
                  aria-controls="employees-rank-boh-panel"
                  aria-selected="false">
                  BOH
                </button>
              </li>
            </ul>

            <div class="tab-content">
              <section
                class="tab-pane fade show active"
                id="employees-rank-foh-panel"
                role="tabpanel"
                aria-labelledby="employees-rank-foh-tab"
                tabindex="0">
                <% if foh_positions.any? %>
                  <div class="d-grid gap-4">
                    <% foh_positions.each do |position| %>
                      <% ranked_employee_positions = position.employee_positions.joins(:employee).merge(Employee.active).includes(:employee).ordered %>
                      <section class="border rounded p-3 bg-light-subtle">
                        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                          <div>
                            <h3 class="h6 fw-semibold mb-1"><%= position.name %></h3>
                            <p class="text-secondary mb-0"><%= position.section_label %></p>
                          </div>
                          <span class="badge text-bg-light border"><%= pluralize(ranked_employee_positions.count, "ranked employee") %></span>
                        </div>
                        <% if ranked_employee_positions.any? %>
                          <div class="table-responsive">
                            <table class="table align-middle mb-0">
                              <tbody
                                data-controller="employee-sort"
                                data-employee-sort-url-value="<%= reorder_employees_location_position_path(@location, position) %>">
                                <% ranked_employee_positions.each do |employee_position| %>
                                  <tr draggable="true" data-employee-sort-target="row" data-employee-id="<%= employee_position.employee_id %>">
                                    <td class="position-drag-column text-center text-secondary">
                                      <button type="button" class="btn btn-sm btn-link text-secondary text-decoration-none px-1 position-drag-handle" aria-label="Drag to reorder">
                                        <i class="bi bi-grip-vertical"></i>
                                      </button>
                                    </td>
                                    <td class="fw-medium"><%= employee_position.employee.display_name %></td>
                                  </tr>
                                <% end %>
                              </tbody>
                            </table>
                          </div>
                        <% else %>
                          <div class="text-secondary">No active employees assigned to this position.</div>
                        <% end %>
                      </section>
                    <% end %>
                  </div>
                <% else %>
                  <div class="text-secondary">No FOH positions available for ranking yet.</div>
                <% end %>
              </section>

              <section
                class="tab-pane fade"
                id="employees-rank-boh-panel"
                role="tabpanel"
                aria-labelledby="employees-rank-boh-tab"
                tabindex="0">
                <% if boh_positions.any? %>
                  <div class="d-grid gap-4">
                    <% boh_positions.each do |position| %>
                      <% ranked_employee_positions = position.employee_positions.joins(:employee).merge(Employee.active).includes(:employee).ordered %>
                      <section class="border rounded p-3 bg-light-subtle">
                        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                          <div>
                            <h3 class="h6 fw-semibold mb-1"><%= position.name %></h3>
                            <p class="text-secondary mb-0"><%= position.section_label %></p>
                          </div>
                          <span class="badge text-bg-light border"><%= pluralize(ranked_employee_positions.count, "ranked employee") %></span>
                        </div>
                        <% if ranked_employee_positions.any? %>
                          <div class="table-responsive">
                            <table class="table align-middle mb-0">
                              <tbody
                                data-controller="employee-sort"
                                data-employee-sort-url-value="<%= reorder_employees_location_position_path(@location, position) %>">
                                <% ranked_employee_positions.each do |employee_position| %>
                                  <tr draggable="true" data-employee-sort-target="row" data-employee-id="<%= employee_position.employee_id %>">
                                    <td class="position-drag-column text-center text-secondary">
                                      <button type="button" class="btn btn-sm btn-link text-secondary text-decoration-none px-1 position-drag-handle" aria-label="Drag to reorder">
                                        <i class="bi bi-grip-vertical"></i>
                                      </button>
                                    </td>
                                    <td class="fw-medium"><%= employee_position.employee.display_name %></td>
                                  </tr>
                                <% end %>
                              </tbody>
                            </table>
                          </div>
                        <% else %>
                          <div class="text-secondary">No active employees assigned to this position.</div>
                        <% end %>
                      </section>
                    <% end %>
                  </div>
                <% else %>
                  <div class="text-secondary">No BOH positions available for ranking yet.</div>
                <% end %>
              </section>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
<% else %>
  <div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-md-5">
      <h2 class="h4 fw-semibold mb-2">Add employees for <%= @location.name %></h2>
      <p class="text-secondary mb-4">Employees can be assigned one or more positions for this location.</p>
      <%= link_to "Add Employee", new_location_employee_path(@location), class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
